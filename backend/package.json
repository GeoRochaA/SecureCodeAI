{
  "name": "securecode-scanner",
  "version": "1.0.0",
  "description": "Analisador estático de vulnerabilidades em código",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
