  "keywords": [
    "security",
    "scanner",
    "vulnerability",
    "code-analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.10",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2"
  }
}
